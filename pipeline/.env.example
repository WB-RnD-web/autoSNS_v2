# pipeline/.env (이 파일을 .env 로 복사해 값 채우기). 절대 커밋 금지 — .gitignore 처리됨.

# ── 무료 이미지 생성 (Google Gemini 2.5 Flash Image = nano-banana) ──
# https://aistudio.google.com/apikey 에서 무료 발급(카드 불필요)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── 스마트 대본(옵션) ─────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── 자막 폰트(한국어) ─────────────────────────
FONT_PATH=/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf

# ── YouTube 업로드 ───────────────────────────
# Google Cloud OAuth 데스크톱 클라이언트 → client_secret.json 경로
YT_CLIENT_SECRET=pipeline/secrets/client_secret.json
YT_TOKEN=pipeline/secrets/token.json
DEFAULT_PRIVACY=private          # 반자동 권장: private 로 올리고 사람이 검수 후 공개

# ── Instagram Reels (Graph API) ──────────────
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Threads (Threads API / Meta) ─────────────
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 생성(Higgsfield) — 결제·API키 준비 후 ─────
HIGGSFIELD_API_KEY=
